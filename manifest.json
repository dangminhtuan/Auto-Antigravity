{
  "manifest_version": 3,
  "name": "AGY Auto-Approve",
  "version": "1.0.12",
  "description": "Tu dong phe duyet approval prompt cua Google Antigravity voi countdown co the huy.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.usercontent.goog/*",
    "https://*.goog/*",
    "https://*.antigravity.google/*",
    "https://*.vscode-webview.net/*",
    "https://*.vscode-cdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://*.google.com/*",
        "https://*.googleusercontent.com/*",
        "https://*.usercontent.goog/*",
        "https://*.goog/*",
        "https://*.antigravity.google/*",
        "https://*.vscode-webview.net/*",
        "https://*.vscode-cdn.net/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AGY Auto-Approve"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
